{
  "name": "cyber-heist",
  "private": true,
  "version": "0.1.0",
  "description": "Social deduction bank heist - rules engine, sandbox and online play",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/engine/*.test.ts src/net/*.test.ts",
    "deploy": "npm run build && npx firebase-tools deploy",
    "deploy:rules": "npx firebase-tools deploy --only database"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "firebase": "^11.10.0"
  }
}
