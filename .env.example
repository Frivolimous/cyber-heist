# Firebase web config for online play. Copy this file to .env.local and fill it in from the Firebase
# console: Project settings > General > Your apps > (the web app) > SDK setup and configuration > Config.
# The database URL is on the Realtime Database page. Without these, online play runs in local mode
# (shared between the tabs of one browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
